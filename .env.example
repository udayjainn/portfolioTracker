# Copy to backend/.env, pipeline/.env, web/.env.local as needed.
# Local dev uses docker-compose defaults; production uses Neon + Upstash (see docs/INFRA_PHASE1.md).

# --- Shared / API (backend) ---
# Docker Compose maps Postgres/Redis to 5433/6380 when 5432/6379 are in use
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/portfolio_tracker
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# Firebase (Phase 1 watchlist — optional until auth task)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Sentry (optional)
SENTRY_DSN=

# --- Pipeline ---
CELERY_BROKER_URL=redis://localhost:6380/1
CONTACT_EMAIL=you@example.com
# SEC 13F bulk ZIP (quarterly); override per SEC data-sets page
# SEC_13F_BULK_URL=https://www.sec.gov/files/structureddata/data/form-13f-data-sets/2024q4_13f.zip
# INGEST_LIMIT=5

# --- Web (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
