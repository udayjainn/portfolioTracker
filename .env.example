# Copy to backend/.env, pipeline/.env, web/.env.local as needed.
# Local dev uses docker-compose defaults; production uses Neon + Upstash (see docs/INFRA_PHASE1.md).

# --- Shared / API (backend) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio_tracker
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# Firebase (Phase 1 watchlist — optional until auth task)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Sentry (optional)
SENTRY_DSN=

# --- Pipeline ---
CELERY_BROKER_URL=redis://localhost:6379/1
CONTACT_EMAIL=you@example.com

# --- Web (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
